  const probeHash = hashValue_(probeValue);
  try {
    result.writeAttempted = true;
    range.setValue(probeValue);
    result.googleSheetsUpdated = true;
    if (typeof SpreadsheetApp !== 'undefined' && SpreadsheetApp.flush) {
