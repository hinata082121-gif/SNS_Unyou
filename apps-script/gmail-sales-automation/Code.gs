    return locked;
  }
  try {
    const result = runGmailSalesAutomatedEvidenceRecoveryStepWorker_({ source: 'manual_safe_step' });
    logGmailSalesJsonResult_(result);
    return result;
  } finally {
    lock.releaseLock();
  }
