function inspectGmailSalesAutomatedEvidenceRecoveryStatus_(options) {
  const config = getGmailSalesAiConfig_();
  const context = getGmailSalesContactBasisReviewContext_();
  const state = readGmailSalesAutomatedEvidenceRecoveryState_();
  const usage = summarizeGmailSalesRecoveryDailyUsage_(config);
  const result = buildGmailSalesAutomatedEvidenceRecoveryResult_('pass', {
    mode: 'read_only',
    aiEnabled: config.enabled,
    aiProvider: config.provider,
    estimatedCostYen: Number(usage.estimatedCostYen || 0),
    cumulativeEstimatedCostYen: Number(usage.cumulativeEstimatedCostYen || 0),
    budgetRemainingYen: Number(usage.budgetRemainingYen || 0),
    dailyCostLimitYen: Number(usage.dailyCostLimitYen || 0),
    recoveryUsageOperationCount: Number(usage.recoveryUsageOperationCount || 0),
    checkpointState: state.checkpointState,
    checkpointCursor: Number(state.checkpointCursor || 0)
  });
  if (!context.ok) {
    result.status = 'blocked';
    result.blockedReasons = [context.blockedReason || 'contact_basis_context_unavailable'];
    if (!(options && options.skipLog)) logGmailSalesJsonResult_(result);
    return result;
  }
  const sourceData = readSheetObjects_(context.sourceSheet);
  const reviewData = readSheetObjects_(context.reviewSheet);
  const reviewById = {};
  (reviewData.items || []).forEach((item) => {
    const id = String(item.row.reviewId || '').trim();
    if (id) reviewById[id] = item;
  });
  result.sourceCandidateCount = (sourceData.items || []).length;
  const uniqueDigests = {};
  (sourceData.items || []).forEach((sourceItem) => {
    const queue = buildContactBasisReviewQueueRow_(sourceItem, new Date().toISOString());
    if (!queue.include) {
      result.hardBlockedCount += 1;
      return;
    }
    const evidence = collectGmailSalesContactBasisEvidence_(sourceItem.row, queue.row);
    const deterministic = buildDeterministicGmailSalesAiDecision_(evidence);
    const payload = buildMinimizedAiEvidencePayload_(evidence, config);
    const payloadValid = deterministic.status === 'needs_ai' && validateGmailSalesAiPayloadMinimized_(payload);
    const digest = String(evidence.canonicalEvidenceDigest || '').trim();
    const reviewItem = reviewById[queue.row.reviewId];
    const previousDigest = String(sourceItem.row.lastAiEvaluatedEvidenceDigest || (reviewItem && reviewItem.row.lastAiEvaluatedEvidenceDigest) || '').trim();
    if (!payloadValid) {
      result.evidenceMissingCount += 1;
      return;
    }
    result.evidenceReadyCount += 1;
    if (!digest) {
      result.emptyDigestButReadyCount += 1;
      return;
    }
    result.canonicalEvidenceDigestCount += 1;
    uniqueDigests[digest] = true;
    if (previousDigest && constantTimeEquals_(previousDigest, digest)) result.unchangedDigestSkippedCount += 1;
    else result.changedDigestEligibleCount += 1;
  });
  (reviewData.items || []).forEach((item) => {
    const decision = String(item.row.reviewDecision || '').trim();
    const applyStatus = String(item.row.applyStatus || '').trim();
    if (decision === 'approved_ai') result.aiApprovedCount += 1;
    if (decision === 'needs_more_evidence') result.aiNeedsMoreEvidenceCount += 1;
    const errorCode = String(item.row.applyErrorCode || item.row.aiReasonCodes || '').trim();
    if (errorCode.indexOf('policy') !== -1 || errorCode.indexOf('solicitation') !== -1) result.aiPolicyBlockedCount += 1;
    const disposition = classifyGmailSalesAiReviewEvidenceRecoveryDisposition_(item.row);
    if (disposition.retryable) result.aiEvidenceRetryableCount += 1;
    if (disposition.terminal) result.aiTerminalPolicyHoldCount += 1;
    if (applyStatus === 'applied_ai') result.basisAppliedCount += 1;
    if (decision === 'approved_ai' && applyStatus !== 'applied_ai') result.basisApplyPendingCount += 1;
  });
  const coverage = inspectGmailSalesContactBasisCoverage_({});
  const manifestStatus = inspectGmailSalesAutomatedEvidenceManifestStatus_();
  const aiCooldown = inspectGmailSalesAiProviderCooldown_();
  const aiBlockedByCooldown = (aiCooldown.aiProviderCooldownActive === true || aiCooldown.aiProviderRateLimitedToday === true) &&
    Number(result.changedDigestEligibleCount || 0) > 0;
  Object.assign(result, aiCooldown, {
    aiPendingBlockedByCooldown: aiBlockedByCooldown,
    aiRetrySafeToExecute: !aiBlockedByCooldown,
    aiRetryRecommendedAction: aiBlockedByCooldown ? 'wait_for_ai_provider_cooldown' : 'run_ai_contact_basis_verification'
  });
  result.readyInventoryCount = Number(coverage.eligibleAfterBasisCheckCount || 0);
  result.shortfallToThirty = Math.max(0, gmailDailyExpectedCount_() - result.readyInventoryCount);
  result.uniqueCanonicalEvidenceDigestCount = Object.keys(uniqueDigests).length;
  result.aiPendingCount = result.changedDigestEligibleCount;
  result.deterministicAcceptedCount = Number(coverage.approvedBasisCount || 0);
  result.deterministicRejectedCount = result.hardBlockedCount + result.evidenceMissingCount + result.emptyDigestButReadyCount;
  result.retryableCandidateCount = result.evidenceMissingCount + result.aiEvidenceRetryableCount;
  result.terminalCandidateCount = result.hardBlockedCount;
  result.evidenceRecoveryEligibleCount = result.retryableCandidateCount;
  result.evidenceRecoveryAction = result.evidenceRecoveryEligibleCount > 0 ? 'evidence_package_recovery' : '';
  if (result.evidenceRecoveryEligibleCount > 0) {
    const sourceReferenceReadiness = inspectGmailSalesSourceReferenceTransactionReadiness_({ skipLog: true });
    const legacyPromotionReadiness = inspectGmailSalesReviewLegacyReferencePromotionReadiness_({ skipLog: true });
    const enrichmentReadiness = inspectGmailSalesOfficialEvidenceEnrichmentReadiness_({ skipLog: true });
    const fetchReadiness = inspectGmailSalesOfficialEvidenceFetchReadiness_({ skipLog: true });
    const recoveryPlan = planGmailSalesEvidenceRecoveryAction_(result, {
      sourceReferenceReadiness,
      legacyPromotionReadiness,
      enrichmentReadiness,
      fetchReadiness
    });
    Object.assign(result,
      summarizeGmailSalesSourceReferenceReadinessForRecovery_(sourceReferenceReadiness),
      summarizeGmailSalesLegacyReferencePromotionReadiness_(legacyPromotionReadiness),
      summarizeGmailSalesEvidenceRecoveryActionReadiness_(enrichmentReadiness, fetchReadiness),
      getGmailSalesRecoveryOperationalConfig_(),
      recoveryPlan);
    Object.assign(result, buildGmailSalesPlannedRecoveryActionSummary_(result));
  }
  if ((result.aiProviderCooldownActive || result.aiProviderRateLimitedToday) && Number(result.changedDigestEligibleCount || 0) > 0) {
    result.aiPendingBlockedByCooldown = true;
    result.aiRetrySafeToExecute = false;
    result.aiRetryRecommendedAction = String(result.plannedNextAction || '') === 'legacy_review_reference_promotion'
      ? 'run_legacy_reference_promotion_safe_step'
      : 'wait_for_ai_provider_cooldown';
  }
  result.operatorRecommendedNextFunction = result.plannedSafeToExecute === true ? 'runGmailSalesAutomatedEvidenceRecoveryStepOnce' : '';
  result.operatorRecommendedNextFunctionReason = (result.aiProviderCooldownActive || result.aiProviderRateLimitedToday) && result.operatorRecommendedNextFunction
    ? (result.aiProviderCooldownInferredFromLastRunSummary ? 'ai_recent_rate_limit_but_legacy_promotion_available' : 'ai_cooldown_but_legacy_promotion_available')
    : (result.operatorRecommendedNextFunction ? (result.plannedNextActionReasonCode || 'safe_step_available') : '');
  result.operatorShouldRunSafeStepNow = Boolean(result.operatorRecommendedNextFunction);
  result.operatorShouldWaitReason = result.operatorShouldRunSafeStepNow ? '' : ((result.aiProviderCooldownActive || result.aiProviderRateLimitedToday) ? 'wait_for_ai_provider_cooldown' : '');
  result.manifestReady = manifestStatus.manifestReady;
  result.manifestExists = manifestStatus.manifestExists;
  result.manifestCount = manifestStatus.manifestCount;
  result.manifestUniqueCount = manifestStatus.manifestUniqueCount;
  result.manifestDuplicateCount = manifestStatus.manifestDuplicateCount;
  result.currentManifestMaxSendCount = manifestStatus.currentManifestMaxSendCount;
  result.manifestTargetDateMatched = manifestStatus.manifestTargetDateMatched;
  result.manifestStale = manifestStatus.manifestStale;
  result.checkpointState = planGmailSalesAutomatedEvidenceRecoveryNextAction_(result);
  result.nextAction = result.checkpointState;
  if (!String(result.plannedNextAction || '').trim()) Object.assign(result, buildGmailSalesPlannedRecoveryActionSummary_(result));
  result.operatorRecommendedNextFunction = result.plannedSafeToExecute === true ? 'runGmailSalesAutomatedEvidenceRecoveryStepOnce' : '';
  result.operatorRecommendedNextFunctionReason = (result.aiProviderCooldownActive || result.aiProviderRateLimitedToday) && result.operatorRecommendedNextFunction
    ? (result.aiProviderCooldownInferredFromLastRunSummary ? 'ai_recent_rate_limit_but_legacy_promotion_available' : 'ai_cooldown_but_legacy_promotion_available')
    : (result.operatorRecommendedNextFunction ? (result.plannedNextActionReasonCode || 'safe_step_available') : '');
  result.operatorShouldRunSafeStepNow = Boolean(result.operatorRecommendedNextFunction);
  result.operatorShouldWaitReason = result.operatorShouldRunSafeStepNow ? '' : ((result.aiProviderCooldownActive || result.aiProviderRateLimitedToday) ? 'wait_for_ai_provider_cooldown' : '');
  if (result.emptyDigestButReadyCount > 0) result.blockedReasons.push('empty_digest_but_ready');
  if (result.shortfallToThirty > 0) result.blockedReasons.push('ready_inventory_below_30');
  result.status = result.blockedReasons.length > 0 ? 'blocked' : 'pass';
  if (!(options && options.skipLog)) logGmailSalesJsonResult_(result);
  return result;
}

