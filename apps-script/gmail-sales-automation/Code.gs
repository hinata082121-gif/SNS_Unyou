  if (!extracted.isPublicBusinessChannel) return Object.assign(extracted, {
    ok: false,
    reasonCode: 'no_business_contact_evidence',
    evidenceFetchStatus: 'missing',
    evidenceFetchErrorCategory: 'no_business_contact_evidence'
