    citationUrlIdentityValidationAttemptCount: Number(summary.citationUrlIdentityValidationAttemptCount || 0),
    citationUrlFinalAcceptedCount: Number(summary.citationUrlFinalAcceptedCount || 0),
    recommendedNextAction,
