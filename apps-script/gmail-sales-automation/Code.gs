    probeScenarioVersion: String(summary.probeScenarioVersion || GMAIL_SALES_GROUNDING_CITATION_ACCEPTANCE_PROBE_SCENARIO_VERSION),
    urlCitationAnnotationCount: Number(summary.urlCitationAnnotationCount || 0),
