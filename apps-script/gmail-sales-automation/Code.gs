function validateGroundingCitationIdentityForTarget_(safety, target) {
  const expectedHosts = (target && target.expectedOfficialCitationHosts || []).map((host) => String(host || '').toLowerCase()).filter(Boolean);
  if (expectedHosts.length === 0) return { accepted: true, reasonCode: 'identity_not_constrained' };
  const host = String(safety && safety.host || '').toLowerCase();
  const hostAccepted = expectedHosts.some((expected) => host === expected || host.endsWith('.' + expected));
  if (!hostAccepted) return { accepted: false, reasonCode: 'expected_official_identity_mismatch' };
  if (String(safety && safety.normalizedCategory || '') !== 'official_documentation') return { accepted: false, reasonCode: 'expected_official_documentation_mismatch' };
  return { accepted: true, reasonCode: 'expected_official_documentation_matched' };
}

function collectCitationUrls_(value, urls) {
  if (!value || urls.length > 20) return;
  if (typeof value === 'string') return;
  if (Array.isArray(value)) {
    value.forEach((item) => collectCitationUrls_(item, urls));
    return;
  }
  if (typeof value === 'object') {
    const maybeUrl = value.url || value.uri || value.sourceUrl;
    if (maybeUrl && (value.urlCitation || value.url_citation || value.web || value.title || value.uri)) urls.push(String(maybeUrl));
    Object.keys(value).forEach((key) => collectCitationUrls_(value[key], urls));
  }
}

function normalizeGroundingCitationUrl_(url) {
  return normalizeGroundingCitationUrlAppsScriptSafe_(url);
}

function parseGroundingCitationUrlAppsScriptSafe_(value) {
  if (typeof value !== 'string') return { ok: false, reasonCode: 'non_string_url' };
  const raw = value.trim();
  if (!raw) return { ok: false, reasonCode: 'empty_url' };
  if (/[\u0000-\u001F\u007F]/.test(raw)) return { ok: false, reasonCode: 'control_character' };
  if (/%(?![0-9A-Fa-f]{2})/.test(raw)) return { ok: false, reasonCode: 'malformed_percent_encoding' };
  return parseHttpsUrlComponentsWithoutBrowserApi_(raw);
}

function parseHttpsUrlComponentsWithoutBrowserApi_(raw) {
  const schemeMatch = String(raw || '').match(/^([A-Za-z][A-Za-z0-9+.-]*):\/\//);
  if (!schemeMatch) return { ok: false, reasonCode: 'malformed_scheme' };
  const scheme = schemeMatch[1].toLowerCase();
  if (scheme !== 'https') return { ok: false, reasonCode: 'unsupported_scheme' };
  let rest = raw.slice(schemeMatch[0].length);
  const fragmentIndex = rest.indexOf('#');
  if (fragmentIndex !== -1) rest = rest.slice(0, fragmentIndex);
  const firstPathIndex = firstIndexOfAny_(rest, ['/', '?']);
  const authority = firstPathIndex === -1 ? rest : rest.slice(0, firstPathIndex);
  let pathAndQuery = firstPathIndex === -1 ? '' : rest.slice(firstPathIndex);
  if (!authority) return { ok: false, reasonCode: 'malformed_authority' };
  if (authority.indexOf('@') !== -1) return { ok: false, reasonCode: 'credential_in_url' };
  let host = authority;
  let port = '';
  if (authority.charAt(0) === '[') {
    const closing = authority.indexOf(']');
    if (closing === -1) return { ok: false, reasonCode: 'malformed_hostname' };
    host = authority.slice(1, closing);
    if (authority.slice(closing + 1).charAt(0) === ':') port = authority.slice(closing + 2);
    else if (authority.slice(closing + 1)) return { ok: false, reasonCode: 'malformed_hostname' };
  } else if (authority.lastIndexOf(':') !== -1) {
    const colon = authority.lastIndexOf(':');
    host = authority.slice(0, colon);
    port = authority.slice(colon + 1);
  }
  host = String(host || '').toLowerCase().replace(/\.$/, '');
  if (!host) return { ok: false, reasonCode: 'missing_hostname' };
  if (/\s/.test(host) || host.indexOf('/') !== -1) return { ok: false, reasonCode: 'malformed_hostname' };
  if (port) {
    if (!/^\d+$/.test(port)) return { ok: false, reasonCode: 'invalid_port' };
    const portNumber = Number(port);
    if (!Number.isFinite(portNumber) || portNumber < 1 || portNumber > 65535) return { ok: false, reasonCode: 'invalid_port' };
    if (port === '443') port = '';
  }
  if (!pathAndQuery) pathAndQuery = '/';
  if (pathAndQuery.charAt(0) === '?') pathAndQuery = '/' + pathAndQuery;
  const queryIndex = pathAndQuery.indexOf('?');
  let path = queryIndex === -1 ? pathAndQuery : pathAndQuery.slice(0, queryIndex);
  const query = queryIndex === -1 ? '' : pathAndQuery.slice(queryIndex + 1);
  if (!path) path = '/';
  path = path.replace(/\/{2,}/g, '/');
  const normalizedQuery = normalizeGroundingCitationQueryString_(query);
  const authorityOut = host + (port ? ':' + port : '');
  return {
    ok: true,
    scheme,
    host,
    hostname: host,
    port,
    path,
    query: normalizedQuery,
    url: 'https://' + authorityOut + path + (normalizedQuery ? '?' + normalizedQuery : '')
  };
}

function normalizeGroundingCitationUrlAppsScriptSafe_(value) {
  return parseGroundingCitationUrlAppsScriptSafe_(value);
}

function firstIndexOfAny_(text, chars) {
  let found = -1;
  chars.forEach((char) => {
    const index = text.indexOf(char);
    if (index !== -1 && (found === -1 || index < found)) found = index;
  });
  return found;
}

function normalizeGroundingCitationQueryString_(query) {
  if (!query) return '';
  const tracking = {
    utm_source: true,
    utm_medium: true,
    utm_campaign: true,
    utm_term: true,
    utm_content: true,
    fbclid: true,
    gclid: true
  };
  return String(query).split('&').filter((part) => {
    if (!part) return false;
    const key = part.split('=')[0].toLowerCase();
    return !tracking[key];
  }).join('&');
}

function recordGroundingCitationUrlSyntaxDiagnostics_(result, value) {
  const valueType = value === null ? 'null' : typeof value;
  incrementCount_(result.citationUrlValueTypeCounts, valueType);
  if (typeof value === 'string') result.citationUrlStringCount += 1;
  else result.citationUrlNonStringCount += 1;
  const text = typeof value === 'string' ? value : '';
  const trimmed = text.trim();
  if (!trimmed) result.citationUrlEmptyCount += 1;
  if (/[\u0000-\u001F\u007F]/.test(text)) result.citationUrlControlCharacterCount += 1;
  const lower = trimmed.toLowerCase();
  if (lower.indexOf('https://') === 0) result.citationUrlHttpsPrefixCount += 1;
  else if (lower.indexOf('http://') === 0) result.citationUrlHttpPrefixCount += 1;
  else result.citationUrlOtherPrefixCount += 1;
  const length = trimmed.length;
  const bucket = length === 0 ? '0' : (length <= 128 ? '1_128' : (length <= 512 ? '129_512' : (length <= 2048 ? '513_2048' : 'over_2048')));
  incrementCount_(result.citationUrlLengthBucketCounts, bucket);
  const parsed = normalizeGroundingCitationUrl_(value);
  if (!parsed.ok) incrementCount_(result.citationUrlParseFailureReasonCounts, parsed.reasonCode || 'unknown_parse_failure');
  return parsed;
}

function classifyGroundingCitationUrlSafety_(url) {
  const checked = normalizeGroundingCitationUrl_(url);
  if (!checked.ok) return buildGroundingCitationSafetyRejected_(checked, checked.reasonCode || 'malformed_url', 'syntax');
  const host = checked.host;
  if (host === 'localhost' || host.endsWith('.localhost')) return buildGroundingCitationSafetyRejected_(checked, 'localhost', 'local');
  if (isPrivateOrReservedHost_(host)) return buildGroundingCitationSafetyRejected_(checked, 'private_ip', 'private_network');
  if (isLikelyUrlShortenerHost_(host)) return buildGroundingCitationSafetyRejected_(checked, 'url_shortener', 'redirect');
  const category = classifyGroundedCitationDomainCategory_(host, checked.url);
  if (!category.accepted) return buildGroundingCitationSafetyRejected_(checked, category.reasonCode || 'unknown_safety_rejection', category.normalizedCategory || 'blocked');
  return Object.assign({}, checked, {
    ok: true,
    accepted: true,
    reasonCode: category.reasonCode || 'accepted_https_public_web',
    normalizedCategory: category.normalizedCategory || 'public_web',
    redirectResolutionRequired: false,
    safeForIdentityValidation: true
  });
}

function normalizeGroundedCitationUrl_(url) {
  const checked = classifyGroundingCitationUrlSafety_(url);
  if (!checked.ok) return checked;
  return checked;
}

function groundedRejectedDomainCategory_(host, url) {
  const classified = classifyGroundedCitationDomainCategory_(host, url);
  return classified.accepted ? '' : classified.reasonCode;
}

function buildGroundingCitationSafetyRejected_(checked, reasonCode, normalizedCategory) {
  return Object.assign({}, checked || {}, {
    ok: false,
    accepted: false,
    reasonCode: reasonCode || 'unknown_safety_rejection',
    normalizedCategory: normalizedCategory || 'blocked',
    redirectResolutionRequired: reasonCode === 'tracking_redirect' || reasonCode === 'unsupported_google_redirect',
    safeForIdentityValidation: false
  });
}

function classifyGroundedCitationDomainCategory_(host, url) {
  const h = String(host || '').toLowerCase();
  const value = String(url || '').toLowerCase();
  const social = ['facebook.com', 'instagram.com', 'x.com', 'twitter.com', 'linkedin.com', 'youtube.com', 'tiktok.com'];
  const directory = ['yelp.com', 'tripadvisor.com', 'hotpepper.jp', 'ekiten.jp', 'navitime.co.jp'];
  const review = ['trustpilot.com', 'reviews.io', 'minhyo.jp'];
  const marketplace = ['amazon.co.jp', 'amazon.com', 'rakuten.co.jp', 'yahoo.co.jp'];
  const jobs = ['indeed.com', 'wantedly.com', 'green-japan.com', 'rikunabi.com', 'mynavi.jp'];
  const pr = ['prtimes.jp', 'value-press.com', 'atpress.ne.jp'];
  if (isGroundedCitationOfficialDocumentationHost_(h)) return { accepted: true, reasonCode: 'accepted_official_documentation', normalizedCategory: 'official_documentation' };
  if (isGroundedCitationGoogleServiceHost_(h)) return classifyGroundedGoogleCitationService_(h, value);
  if (social.some((d) => h === d || h.endsWith('.' + d))) return { accepted: false, reasonCode: 'social_network', normalizedCategory: 'social_network' };
  if (directory.some((d) => h === d || h.endsWith('.' + d))) return { accepted: false, reasonCode: 'business_directory', normalizedCategory: 'business_directory' };
  if (review.some((d) => h === d || h.endsWith('.' + d))) return { accepted: false, reasonCode: 'review_site', normalizedCategory: 'review_site' };
  if (marketplace.some((d) => h === d || h.endsWith('.' + d))) return { accepted: false, reasonCode: 'marketplace', normalizedCategory: 'marketplace' };
  if (jobs.some((d) => h === d || h.endsWith('.' + d))) return { accepted: false, reasonCode: 'job_site', normalizedCategory: 'job_site' };
  if (pr.some((d) => h === d || h.endsWith('.' + d))) return { accepted: false, reasonCode: 'press_release_distribution', normalizedCategory: 'press_release_distribution' };
  return { accepted: true, reasonCode: 'accepted_https_public_web', normalizedCategory: 'public_web' };
}

function isGroundedCitationOfficialDocumentationHost_(host) {
  const h = String(host || '').toLowerCase();
  return [
    'developers.google.com',
    'cloud.google.com',
    'firebase.google.com',
    'developer.apple.com',
    'learn.microsoft.com',
    'developer.mozilla.org',
    'docs.github.com',
    'docs.stripe.com',
    'platform.openai.com'
  ].some((domain) => h === domain || h.endsWith('.' + domain));
}

function isGroundedCitationGoogleServiceHost_(host) {
  const h = String(host || '').toLowerCase();
  return h === 'google.com' || h.endsWith('.google.com') || h === 'goo.gl' || h.endsWith('.goo.gl');
}

function classifyGroundedGoogleCitationService_(host, value) {
  const h = String(host || '').toLowerCase();
  const url = String(value || '').toLowerCase();
  if (h === 'goo.gl' || h.endsWith('.goo.gl')) return { accepted: false, reasonCode: 'url_shortener', normalizedCategory: 'redirect' };
  if (url.indexOf('/maps') !== -1 || h === 'maps.google.com') return { accepted: false, reasonCode: 'map_listing', normalizedCategory: 'map_listing' };
  if (h === 'news.google.com') return { accepted: false, reasonCode: 'unrelated_google_service', normalizedCategory: 'news_service' };
  if (h === 'accounts.google.com' || h === 'myaccount.google.com') return { accepted: false, reasonCode: 'unrelated_google_service', normalizedCategory: 'account_service' };
  if ((h === 'www.google.com' || h === 'google.com') && (url.indexOf('/url?') !== -1 || url.indexOf('/amp/') !== -1)) return { accepted: false, reasonCode: 'unsupported_google_redirect', normalizedCategory: 'redirect' };
  if ((h === 'www.google.com' || h === 'google.com') && (url.indexOf('/search') !== -1 || url.indexOf('?q=') !== -1)) return { accepted: false, reasonCode: 'unrelated_google_service', normalizedCategory: 'search_service' };
  return { accepted: false, reasonCode: 'unrelated_google_service', normalizedCategory: 'google_service' };
}

function selectVerifiedGroundedOfficialSource_(target, citations, grounding) {
  const identity = target.publicBusinessIdentity || buildPublicBusinessIdentity_(target.sourceItem.row || {}, target.reviewItem.row || {});
  const candidateName = normalizeTextForComparison_(identity.publicBusinessName || identity.publicBrandName || identity.publicServiceName || '');
  for (let index = 0; index < citations.length; index += 1) {
    const citation = citations[index];
    if (citation.candidateToken !== target.candidateToken) return { ok: false, status: 'ambiguous' };
    if (citation.officialConfidence < grounding.minOfficialConfidence) continue;
    if (!citation.businessIdentityMatched || citation.riskFlags.length > 0) continue;
    if (!candidateName) continue;
    return {
      ok: true,
      status: 'verified',
      sourceReference: citation.url,
      sourceReferenceHash: buildGmailSalesSourceReferenceHash_('grounded_official_source', citation.url),
      officialDomainHash: hashValue_(citation.host),
      officialConfidence: citation.officialConfidence,
      contactPageDiscovered: citation.contactPageDiscovered,
      businessInquiryEvidencePresent: citation.businessInquiryEvidencePresent,
      solicitationRestrictionPresent: citation.solicitationRestrictionPresent,
      reasonCodes: citation.reasonCodes.length ? citation.reasonCodes : ['grounded_official_source_verified'],
      citationDigest: hashValue_(citation.url + '|' + citation.officialConfidence + '|' + citation.reasonCodes.join(',')),
      sourceDiscoveryDigest: hashValue_(target.candidateToken + '|' + citation.url + '|' + grounding.version)
    };
  }
  return citations.length > 0 ? { ok: false, status: 'ambiguous' } : { ok: false, status: 'missing' };
}

function applyVerifiedSourceReference_(context, sourceData, reviewData, replenishmentSheet, replenishmentData, target, verified, now, stats, sourceSnapshots, reviewSnapshots, queueSnapshots) {
  const sourceHeaders = sourceData.headers;
  const reviewHeaders = reviewData.headers;
