  }
  if (estimatedActionCost > Number(usage.budgetRemainingYen || 0)) {
    return Object.assign({}, summary, {
      status: 'blocked',
      blockedReason: 'budget_limit_reached',
      actionStatus: 'blocked',
      actionBlockedReason: 'budget_limit_reached',
      actionEstimatedCostYen: estimatedActionCost,
      evidenceRecoveryAttemptedCount: 0
    });
  }
  let actionResult;
  if (actionPlan.evidenceRecoveryAction === 'source_reference_cell_write_probe') {
    const probe = runGmailSalesSourceReferenceCellWriteProbeWorker_({ source: settings.source || 'automated_evidence_recovery' });
    actionResult = Object.assign({}, summarizeGmailSalesSourceReferenceCellProbeResult_(probe), {
      status: probe.status,
      blockedReason: probe.blockedReason || '',
      recommendedNextAction: probe.probeContractValid ? 'run_single_candidate_source_discovery' : 'inspect_source_reference_transaction_readiness',
      googleSheetsUpdated: Boolean(probe.googleSheetsUpdated),
      scriptPropertiesUpdated: Boolean(probe.scriptPropertiesUpdated || probe.probeContractValid),
      aiApiCalled: false
    });
  } else if (actionPlan.evidenceRecoveryAction === 'legacy_review_reference_promotion') {
    actionResult = promoteGmailSalesReviewLegacyReferencesOnce({ lockAlreadyHeld: true, source: settings.source || 'automated_evidence_recovery', skipLog: true, summaryOnly: true });
  } else if (actionPlan.evidenceRecoveryAction === 'official_evidence_enrichment') {
    actionResult = runGmailSalesOfficialEvidenceEnrichmentOnce({ lockAlreadyHeld: true, source: settings.source || 'automated_evidence_recovery', skipLog: true, summaryOnly: true });
  } else if (actionPlan.evidenceRecoveryAction === 'canonical_source_url_repair') {
    actionResult = repairGmailSalesCommittedCanonicalSourceUrlOnce({ lockAlreadyHeld: true, source: settings.source || 'automated_evidence_recovery' });
  } else if (actionPlan.evidenceRecoveryAction === 'source_verification_attestation_repair') {
    actionResult = repairGmailSalesCommittedSourceVerificationAttestationOnce({ lockAlreadyHeld: true, source: settings.source || 'automated_evidence_recovery' });
  } else if (actionPlan.evidenceRecoveryAction === 'source_reference_digest_repair') {
    actionResult = repairGmailSalesCommittedSourceReferenceDigestOnce({ lockAlreadyHeld: true, source: settings.source || 'automated_evidence_recovery' });
  } else if (actionPlan.evidenceRecoveryAction === 'grounded_official_source_discovery') {
    actionResult = runGmailSalesGroundedOfficialSourceDiscoveryInternal_({
      lockAlreadyHeld: true,
      maxCandidates: 1,
      source: settings.source || 'automated_evidence_recovery',
      skipLog: true,
      summaryOnly: true
    });
  } else {
    return Object.assign({}, summary, {
      status: 'blocked',
      blockedReason: 'no_safe_recovery_action',
      actionStatus: 'blocked',
      actionBlockedReason: 'no_safe_recovery_action',
      evidenceRecoveryAttemptedCount: 0
    });
  }
  const decorated = decorateGmailSalesEvidenceRecoveryActionResult_(Object.assign({}, summary, actionResult, {
    actionStatus: actionResult.status || '',
    actionBlockedReason: actionResult.blockedReason || '',
    actionEstimatedCostYen: estimatedActionCost,
    actionCostYen: Number(actionResult.estimatedCostYen || estimatedActionCost || 0)
  }), actionPlan.evidenceRecoveryAction);
  const postUsage = summarizeGmailSalesRecoveryDailyUsage_(getGmailSalesAiConfig_());
  return Object.assign({}, actionPlan, postUsage, decorated, {
    cumulativeEstimatedCostYen: Number(postUsage.cumulativeEstimatedCostYen || 0),
    estimatedCostYen: Number(postUsage.estimatedCostYen || 0),
    budgetRemainingYen: Number(postUsage.budgetRemainingYen || 0),
    recoveryUsageOperationCount: Number(postUsage.recoveryUsageOperationCount || 0),
    operationTypeCounts: postUsage.operationTypeCounts || {},
    operationCostByType: postUsage.operationCostByType || {},
    backfilledOperationCount: Number(postUsage.backfilledOperationCount || 0),
    ledgerOperationCount: Number(postUsage.ledgerOperationCount || 0),
    duplicateOperationSkippedCount: Number(postUsage.duplicateOperationSkippedCount || 0)
  });
}

function planGmailSalesEvidenceRecoveryAction_(status, readiness) {
  const source = readiness && readiness.sourceReferenceReadiness || {};
  const legacy = readiness && readiness.legacyPromotionReadiness || {};
  const enrichment = readiness && readiness.enrichmentReadiness || {};
  const fetch = readiness && readiness.fetchReadiness || {};
  const reasons = enrichment.enrichmentEligibilityReasonCounts || {};
  const recoveryConfig = getGmailSalesRecoveryOperationalConfig_();
  const legacyAvailableCount = Math.max(
    Number(legacy.legacyPromotionEligibleCount || 0),
    Number(legacy.reviewOnlyPromotionEligibleAfterLocalReverificationCount || 0),
    Number(legacy.promotionEligibleViaSourceReferenceClassificationCount || 0),
    Number(legacy.legacySourceTypeNormalizationEligibleCount || 0),
    Number(legacy.deterministicLocalReverificationEligibleCount || 0),
    Number(legacy.promotionEligibleAfterTypeNormalizationCount || 0),
    Number(legacy.promotionEligibleAfterLocalReverificationCount || 0)
  );
  if (legacyAvailableCount > 0) {
    const rateLimited = status && (status.aiProviderCooldownActive === true || status.aiProviderRateLimitedToday === true);
    const inferredRecent429 = status && status.aiProviderRateLimitedToday === true && status.aiProviderCooldownInferredFromLastRunSummary === true;
    const reasonCode = rateLimited ? (inferredRecent429 ? 'ai_recent_rate_limit_non_ai_recovery_available' : 'ai_cooldown_non_ai_recovery_available')
      : (Number(legacy.promotionEligibleViaSourceReferenceClassificationCount || 0) > 0 ? 'legacy_source_reference_classification_available'
      : (Number(legacy.legacyPromotionEligibleCount || 0) > 0 ? 'legacy_reference_promotion_available'
      : (Number(legacy.promotionEligibleAfterLocalReverificationCount || 0) > 0 ? 'legacy_local_reverification_available' : 'legacy_source_type_normalization_available')));
    return Object.assign(
      buildGmailSalesEvidenceRecoveryActionPlan_('legacy_review_reference_promotion', reasonCode, 'run_legacy_reference_promotion_safe_step', 'none', 'sheet_update', true),
      {
        legacyReferencePromotionPreferred: recoveryConfig.legacyReferencePromotionPreferred,
        groundingFallbackOnly: recoveryConfig.groundingFallbackOnly
      }
    );
  }
  if (shouldRunGmailSalesSourceReferenceCellProbe_(source)) {
    return buildGmailSalesEvidenceRecoveryActionPlan_('source_reference_cell_write_probe', 'source_reference_cell_probe_required', 'run_source_reference_cell_write_probe', 'none', 'sheet_probe_and_property_summary', true);
  }
  if (source.transactionReadinessValid !== true ||
      (source.sourceReferenceCellContractLastProbeValid !== true && Number(source.sourceReferenceEligibleCellCount || 0) > 0)) {
    return buildGmailSalesEvidenceRecoveryActionPlan_('no_safe_recovery_action', 'source_reference_cell_contract_probe_not_safe', 'inspect_source_reference_transaction_readiness', 'none', 'none', false);
  }
  if (Number(enrichment.evidenceEnrichmentEligibleCount || 0) > 0) {
    if (!fetch.fetchReadinessValid && Number(fetch.canonicalSourceUrlRepairEligibleCount || 0) === 1) {
      return buildGmailSalesEvidenceRecoveryActionPlan_('canonical_source_url_repair', 'canonical_source_url_repair_available', 'repair_committed_canonical_source_url', 'none', 'sheet_update', true);
    }
    if (fetch.fetchReadinessValid) {
      return buildGmailSalesEvidenceRecoveryActionPlan_('official_evidence_enrichment', 'official_evidence_fetch_ready', 'run_official_evidence_enrichment', 'url_fetch', 'sheet_update', true);
    }
  }
  if (Number(enrichment.evidenceEnrichmentEligibleCount || 0) === 0 && hasOfficialEvidenceAttestationReason_(reasons)) {
    return buildGmailSalesEvidenceRecoveryActionPlan_('source_verification_attestation_repair', 'source_verification_attestation_repair_available', 'repair_source_verification_attestation', 'none', 'sheet_update', true);
  }
  if (Number(enrichment.evidenceEnrichmentEligibleCount || 0) === 0 &&
      Number(reasons.source_row_digest_mismatch || 0) + Number(reasons.source_row_digest_missing || 0) > 0) {
    return buildGmailSalesEvidenceRecoveryActionPlan_('source_reference_digest_repair', 'source_reference_digest_repair_available', 'repair_committed_source_reference_digest', 'none', 'sheet_update', true);
  }
  if (source.sourceReferenceCellContractLastProbeValid === true &&
      source.transactionReadinessValid === true &&
      Number(source.eligibleTransactionTargetCount || source.sourceReferenceEligibleCellCount || 0) > 0) {
    const promptUsage = getGmailSalesGroundingPromptRequestUsage_();
    const plannedPromptCount = getGmailSalesPlannedGroundingPromptRequestCount_();
    const groundingCandidatesUsedToday = Math.floor(Number(promptUsage.groundingPromptRequestCountToday || 0) / Math.max(1, plannedPromptCount));
    const groundingCandidatesRemainingToday = Math.max(0, Number(recoveryConfig.maxGroundingCandidatesPerDay || 0) - groundingCandidatesUsedToday);
    let groundingBlockedReason = '';
    if (recoveryConfig.freeTierMode && !recoveryConfig.freeTierGroundingEnabled) groundingBlockedReason = 'free_tier_grounding_disabled';
    else if (recoveryConfig.freeTierMode && groundingCandidatesRemainingToday <= 0) groundingBlockedReason = 'free_tier_grounding_daily_candidate_limit_reached';
    else if (recoveryConfig.freeTierMode && Number(promptUsage.remainingGroundingPromptRequestCountToday || 0) <= Number(recoveryConfig.groundingPromptReserve || 0)) groundingBlockedReason = 'grounding_prompt_reserve_reached';
    const promptBudgetSufficient = !groundingBlockedReason && Number(promptUsage.remainingGroundingPromptRequestCountToday || 0) >= plannedPromptCount;
    if (!groundingBlockedReason && !promptBudgetSufficient) groundingBlockedReason = 'grounding_daily_prompt_limit_reached';
    return Object.assign(
      buildGmailSalesEvidenceRecoveryActionPlan_(
        'grounded_official_source_discovery',
        promptBudgetSufficient ? 'grounded_source_discovery_available_because_fetch_readiness_false' : groundingBlockedReason,
        'run_single_candidate_source_discovery',
        'gemini_grounding',
        'sheet_update',
        promptBudgetSufficient
      ),
      {
        groundingPromptRequestCountToday: Number(promptUsage.groundingPromptRequestCountToday || 0),
        dailyPromptRequestLimit: Number(promptUsage.dailyPromptRequestLimit || 0),
        remainingGroundingPromptRequestCountToday: Number(promptUsage.remainingGroundingPromptRequestCountToday || 0),
        plannedGroundingPromptRequestCount: plannedPromptCount,
        groundingPromptBudgetSufficient: promptBudgetSufficient,
        groundingFallbackOnly: recoveryConfig.groundingFallbackOnly,
        freeTierGroundingEnabled: recoveryConfig.freeTierGroundingEnabled,
        freeTierGroundingDailyCandidateLimit: recoveryConfig.maxGroundingCandidatesPerDay,
        groundingCandidatesUsedToday,
        groundingCandidatesRemainingToday,
        groundingModelFailoverMax: recoveryConfig.groundingModelFailoverMax,
        groundingCooldownActive: false,
        groundingBlockedReason,
        actionBlockedReason: promptBudgetSufficient ? '' : groundingBlockedReason
      }
    );
  }
  if (Number(status && status.evidenceRecoveryEligibleCount || 0) > 0) {
    return buildGmailSalesEvidenceRecoveryActionPlan_('candidate_replenishment', 'candidate_replenishment_required', 'replenish_with_new_candidates', 'provider_discovery', 'sheet_update', false);
  }
  return buildGmailSalesEvidenceRecoveryActionPlan_('no_safe_recovery_action', 'no_safe_recovery_action', 'inspect_evidence_recovery_status', 'none', 'none', false);
}

